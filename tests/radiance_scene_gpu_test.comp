#include "radiance_scene_trace.glsl"
#include "radiance_lighting.glsl"
layout(local_size_x = 1) in;
layout(std430, set = 0, binding = 0) buffer Results { vec4 result[]; };
void traceRay(uint slot, vec3 origin, float tmin)
{
    RCSceneHit hit;
    bool found = RC_SceneTrace(origin, vec3(0, 0, -1), tmin, 100, hit);
    result[slot] = found ? vec4(hit.distance, float(hit.material), float(hit.flags), float(hit.triangle)) : vec4(-1);
}
void traceSkyPair(uint slot, vec3 origin, vec3 direction)
{
    RCSceneHit sky;
    bool found = RC_SceneTrace(origin, direction, 0.01, 2.0, sky);
    result[slot] = vec4(float(found && (sky.flags & RC_SCENE_SKY) != 0u),
        found ? RC_ShadeHit(sky, direction).r : -1.0,
        float(RC_LightVisible(origin, direction, direction, 2.0, true)),
        float(RC_LightVisible(origin, direction, direction, 2.0, false)));
}
