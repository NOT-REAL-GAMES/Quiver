 reset(); rcLights[0].metadata.x=RC_LIGHT_EMISSIVE; rcLights[0].area_axis.w=0; evaluate(d,m); result[13]=uint(queries==1u && near(d,.3183098861837907));
 reset(); rcLighting.counts.x=4u; for(int i=0;i<4;++i) rcLights[i].color_intensity.w=float(i+1);
