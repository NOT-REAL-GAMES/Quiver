}
/* Mirror the small image-entry guards around the production sampler. This
 * lets invalid checker cells and signed hard RGB be exercised without new
 * Vulkan image fixtures. Metadata/eligibility/outer rays are production code. */
vec4 post(uint metadata,vec4 hard) {
 return RC_ReceiverSoftResult(metadata,hard,vec3(0),vec3(0,0,1));
}
/* Model the production's two distinct stages: original hard RGB plus
 * query-free metadata, then only three optional outer queries/delta. */
void evaluate(out vec3 direct,out vec3 minimum) {
 vec3 p=vec3(0),n=vec3(0,0,1); direct=vec3(0); minimum=vec3(0); RC_ReceiverShadowReset();
 for(uint j=0u;j<rcLighting.counts.x;++j) {
  uint index=(rcLighting.counts.w&1u)!=0u?rcLightGridIndices[j]:j;
  RCLight light=rcLights[index]; vec3 value=RC_EvaluateOneLight(light,p,n);
  RC_ReceiverShadowSelect(index,light,p,n,value);
  if(RC_IsLocalMinLight(light)) minimum=max(minimum,value); else direct+=value;
 }
