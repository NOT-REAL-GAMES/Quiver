}
vec3 RC_EvaluateOneLightMode(RCLight light,vec3 p,vec3 n,bool unshadowed,out vec3 direction,out float distance) {
 vec3 delta=light.position_radius.xyz-p; direction=normalize(delta); distance=length(delta);
 if(light.metadata.x==RC_LIGHT_DIRECTIONAL) { direction=-light.direction_cone.xyz; distance=1e30; }
