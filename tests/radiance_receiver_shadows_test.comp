uint queries; int queryMode; float blockerHeight; bool targetBounds;
bool RC_IsLocalMinLight(RCLight light) { return (light.metadata.z&17u)==1u && (light.metadata.w&7u)==4u; }
bool RC_EmissiveBasis(RCLight light,out vec3 axis,out vec3 tangent,out vec3 bitangent) {
 axis=vec3(0,0,-1); tangent=vec3(1,0,0); bitangent=vec3(0,1,0);
