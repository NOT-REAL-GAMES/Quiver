}
bool near(vec3 a,float b) { return all(lessThan(abs(a-vec3(b)),vec3(.00001))); }
int partialCount(bool sun,float height) {
 blockerHeight=height; int partial=0;
 RCLight light=rcLights[0]; light.metadata.x=sun?RC_LIGHT_DIRECTIONAL:RC_LIGHT_POINT;
 for(int i=-80;i<=80;++i) {
  vec3 p=vec3(float(i)*.1,0,0),direction; float distance;
  RC_EvaluateOneLightMode(light,p,vec3(0,0,1),true,direction,distance);
  float center=RC_ReceiverHardVisibility(light,p,vec3(0,0,1),direction,distance);
  float value=RC_ReceiverSoftVisibility(light,p,vec3(0,0,1),direction,distance,center,1);
  if(value>0 && value<1) ++partial;
 }
 return partial;
}
