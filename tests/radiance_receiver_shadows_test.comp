}
vec3 RC_EvaluateOneLight(RCLight light,vec3 p,vec3 n) {
 vec3 direction; float distance; return RC_EvaluateOneLightMode(light,p,n,false,direction,distance);
}
vec3 RC_EvaluateUnshadowedLight(RCLight light,vec3 p,vec3 n,out vec3 direction,out float distance) {
 vec3 delta=light.position_radius.xyz-p; direction=normalize(delta); distance=length(delta);
 if(light.metadata.x==RC_LIGHT_DIRECTIONAL) { direction=-light.direction_cone.xyz; distance=1e30; }
 return light.color_intensity.rgb*light.color_intensity.w;
}
#include "radiance_receiver_shadow_source.glsl"
#include "radiance_receiver_shadow_metadata.glsl"
#include "radiance_receiver_shadows.glsl"
float RC_ReceiverHardVisibility(RCLight light,vec3 p,vec3 n,vec3 direction,float distance) {
 return light.metadata.x==RC_LIGHT_EMISSIVE?RC_EmissiveVisibility(light,p,n):float(RC_LightVisible(p,n,direction,distance,light.metadata.x==RC_LIGHT_DIRECTIONAL));
}
void reset() {
 queries=0u; queryMode=1; blockerHeight=10; targetBounds=true;
 rcLighting.counts=uvec4(1,0,0,0); rcLighting.grid_origin=vec4(0); rcLighting.grid_inv_cell_size=vec4(1);
 rcLighting.grid_dimensions=uvec4(1,1,1,16); rcLighting.bounce_parameters=vec4(0,1,0,0); rcLighting.shadow_parameters=vec4(1,4,.05,0);
