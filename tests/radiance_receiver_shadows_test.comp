  rcLights[i].position_radius=vec4(0,0,100,1); rcLights[i].color_intensity=vec4(1);
  rcLights[i].direction_cone=vec4(0,0,-1,2); rcLights[i].metadata=uvec4(0,0,1,0); rcLights[i].area_axis=vec4(0,0,0,4);
  rcLightGridIndices[i]=uint(i);
