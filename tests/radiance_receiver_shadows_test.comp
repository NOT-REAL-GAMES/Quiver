 if(rcLighting.bounce_parameters.y>=.5 || light.area_axis.w<=0 || light.direction_cone.w<=0) {
  source.xy=clamp(p.xy,-vec2(light.area_axis.w,light.direction_cone.w),vec2(light.area_axis.w,light.direction_cone.w));
  vec3 delta=source-p; return float(RC_LightVisible(p,n,normalize(delta),length(delta),false));
 }
