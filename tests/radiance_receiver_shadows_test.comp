 reset(); rcLights[0].metadata.x=RC_LIGHT_DIRECTIONAL; rcLighting.shadow_parameters.z=0; evaluate(d,m); result[1]=uint(queries==1u && near(d,.3183098861837907));
 reset(); queryMode=3; rcLights[0].metadata.x=RC_LIGHT_EMISSIVE; evaluate(d,m); result[2]=uint(queries==4u && targetBounds && near(d,.3183098861837907));
 reset(); rcLights[0].metadata.x=RC_LIGHT_EMISSIVE; rcLighting.bounce_parameters.y=0; evaluate(d,m); result[3]=uint(queries==4u && near(d,.3183098861837907));
 reset(); evaluate(d,m); ok=queries==4u && near(d,.3183098861837907);
 reset(); queryMode=2; rcLights[0].position_radius.x=-2; evaluate(d,m);
 ok=ok && queries==4u && near(d,.25*.3183098861837907);
 reset(); queryMode=2; rcLights[0].position_radius.x=1; evaluate(d,m);
 result[4]=uint(ok && queries==4u && near(d,.5*.3183098861837907));
 reset(); rcLighting.counts.x=10u;
 for(int i=0;i<10;++i) rcLights[i].color_intensity.w=float(i+1);
 evaluate(d,m); result[5]=uint(queries==13u && near(d,55*.3183098861837907));
 reset(); queryMode=2; rcLighting.counts.x=2u; rcLights[0].position_radius.x=-2; rcLights[1].position_radius.x=2;
 evaluate(d,m); result[6]=uint(queries==2u && near(d,.3183098861837907));
 vec3 a,b; rcLights[0].color_intensity.w=1.0001; evaluate(a,m); rcLights[0].color_intensity.w=.9999; evaluate(b,m);
 result[7]=uint(all(lessThan(abs(a-b),vec3(.001))));
 reset(); queryMode=0; int nearPoint=partialCount(false,.01),farPoint=partialCount(false,50);
 result[8]=uint(farPoint>nearPoint+20);
