const uint RC_LIGHT_POINT=0u,RC_LIGHT_SPOT=1u,RC_LIGHT_DIRECTIONAL=2u,RC_LIGHT_EMISSIVE=3u;
struct RCLight { vec4 position_radius,color_intensity,direction_cone; uvec4 metadata; vec4 area_axis; };
