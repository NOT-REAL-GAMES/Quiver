#define RC_RECEIVER_RESOLVE_TEST 1
#include "radiance_receiver_resolve.glsl"
bool resolve(ivec2 p,out vec3 value) { return RC_ReceiverIndirect(p,uvec2(1),vec3(0),vec3(0,0,1),value); }
void main() {
  rcReceiver.viewport=ivec4(0,0,4,4); rcReceiver.normalThreshold=vec4(.99,.01,2,0); visible=true;
  for(int i=0;i<16;i++) ids[i]=uvec2(1);
  for(int i=0;i<4;i++) { statuses[i]=1; positions[i]=vec3(0); normals[i]=vec3(0,0,1); colors[i]=vec3(i); }
  vec3 v;
