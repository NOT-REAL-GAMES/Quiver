  result[14]=uint(!RC_ReceiverIndirect(ivec2(2,2),uvec2(1),vec3(uintBitsToFloat(0x7fc00000u)),vec3(0,0,1),v));
  result[15]=uint(!RC_ReceiverIndirect(ivec2(2,2),uvec2(1),vec3(0),vec3(uintBitsToFloat(0x7f800000u)),v));
}
