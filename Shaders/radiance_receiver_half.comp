#version 460
#extension GL_GOOGLE_include_directive : require
#define RC_CLASSIFY_STREAM 1
#include "radiance_receiver_classify.glsl"
#include "radiance_receiver_scale.glsl"

/* Experimental receiver classification for reduced-resolution direct lighting.
 * The producer writes world normals and a nonzero, per-primitive receiver ID
 * with the same depth/coverage rules as the opaque scene. This shader is
 * evaluated at divisor1,1.5,2,3 or4 with exact viewport-local partitions. 0 = empty, 1 = reusable,
 * 2 = full-resolution fallback. The producer must ensure IDs cannot alias between draws. */
layout(local_size_x = 8, local_size_y = 8) in;

#if RECEIVER_MSAA
layout(set = 0, binding = 0) uniform sampler2DMS receiverDepth;
layout(set = 0, binding = 1) uniform sampler2DMS receiverNormal;
layout(set = 0, binding = 2) uniform usampler2DMS receiverID;
#else
layout(set = 0, binding = 0) uniform sampler2D receiverDepth;
layout(set = 0, binding = 1) uniform sampler2D receiverNormal;
layout(set = 0, binding = 2) uniform usampler2D receiverID;
#endif
layout(rgba32f, set = 0, binding = 3) uniform writeonly image2D halfPosition;
layout(rgba16f, set = 0, binding = 4) uniform writeonly image2D halfNormal;
layout(r32ui, set = 0, binding = 5) uniform writeonly uimage2D halfStatus;

layout(push_constant) uniform Params
{
	mat4 inverseViewProjection;
	ivec4 viewport; /* x/y origin, width/height */
	vec4 ndcTransform; /* multiply pixel coordinates by xy, then add zw */
	uint samples; /* low byte: prepass samples per pixel; bit 8: keep the majority surface of mixed blocks */
	float planeTolerance; /* world units */
	float normalCosine;
	float divisor;
} params;

float depthAt(ivec2 p, int s)
{
#if RECEIVER_MSAA
	return texelFetch(receiverDepth, p, s).r;
#else
	return texelFetch(receiverDepth, p, 0).r;
#endif
}

vec3 normalAt(ivec2 p, int s)
{
#if RECEIVER_MSAA
	return texelFetch(receiverNormal, p, s).xyz;
#else
	return texelFetch(receiverNormal, p, 0).xyz;
#endif
}

uvec2 idAt(ivec2 p, int s)
{
#if RECEIVER_MSAA
	return texelFetch(receiverID, p, s).rg;
#else
	return texelFetch(receiverID, p, 0).rg;
#endif
}

/* Offset of a sample within its pixel. Vulkan's standard locations; the engine
 * only enables multisampling when the device reports it uses them. */
vec2 sampleOffset(int count, int s)
{
#if RECEIVER_MSAA
	const vec2 two[2] = vec2[](vec2(.75,.75), vec2(.25,.25));
	const vec2 four[4] = vec2[](vec2(.375,.125), vec2(.875,.375), vec2(.125,.625), vec2(.625,.875));
	const vec2 eight[8] = vec2[](vec2(.5625,.3125), vec2(.4375,.6875), vec2(.8125,.5625), vec2(.3125,.1875),
		vec2(.1875,.8125), vec2(.0625,.4375), vec2(.6875,.9375), vec2(.9375,.0625));
	return count == 2 ? two[s] : count == 4 ? four[s] : eight[s];
#else
	return vec2(.5);
#endif
}

RCReceiverSample readSample(ivec2 pixel, int s, int sampleCount)
{
	RCReceiverSample point;
	point.id = idAt(pixel, s);
	point.valid = true;
	point.position = vec3(0);
	point.normal = vec3(0);
	if (all(equal(point.id, uvec2(0)))) return point;
	float depth = depthAt(pixel, s);
	vec3 normal = normalAt(pixel, s);
	vec2 ndc = (vec2(pixel) + sampleOffset(sampleCount, s)) * params.ndcTransform.xy + params.ndcTransform.zw;
	vec4 world = params.inverseViewProjection * vec4(ndc, depth, 1.0);
	if (isnan(depth) || isinf(depth) || any(isnan(world)) || any(isinf(world)) ||
		abs(world.w) < 1e-8 || any(isnan(normal)) || any(isinf(normal)) || length(normal) < 1e-8)
	{ point.valid = false; return point; }
	point.position = world.xyz / world.w;
	point.normal = normalize(normal);
	if (any(isnan(point.position)) || any(isinf(point.position))) point.valid = false;
	return point;
}

/* The samples of the block in hand. Classification holds 16: larger blocks
 * spread them evenly, and the sample index turns with the pixel so one location
 * is not reused. */
ivec2 blockFirst, blockSpan, blockTaps;
int blockTotal, blockPicks, blockSamples;

ivec2 pickPixel(uint pick, out int s)
{
	int linear = int(pick) * blockTotal / blockPicks, tap = linear / blockSamples;
	s = (linear + tap) % blockSamples;
	return blockFirst + ivec2(tap % blockTaps.x, tap / blockTaps.x) * blockSpan / blockTaps;
}

RCReceiverSample RC_ClassifyPoint(uint pick)
{
	int s;
	ivec2 localPixel = pickPixel(pick, s);
	return readSample(params.viewport.xy + localPixel, s, blockSamples);
}

void main()
{
	ivec2 block = ivec2(gl_GlobalInvocationID.xy);
	ivec2 extent = RC_ReceiverExtent(params.viewport.zw,params.divisor);
	if (any(greaterThanEqual(block, extent))) return;
	uint status = 2u;
	vec3 firstPosition = vec3(0), firstNormal = vec3(0);
	/* Position w: zero without a receiver, else 1 plus the packed offset of the
	 * pixel whose identity represents this block. */
	float representative = 1.0;
	blockSamples = int(params.samples & 255u);
#if RECEIVER_MSAA
	const bool usable = blockSamples == 2 || blockSamples == 4 || blockSamples == 8;
#else
	const bool usable = blockSamples == 1;
#endif
	if (usable)
	{
		blockFirst = RC_ReceiverFirstPixel(block,params.divisor);
		blockSpan = min(RC_ReceiverFirstPixel(block+1,params.divisor),params.viewport.zw) - blockFirst;
		blockTaps = min(blockSpan, ivec2(4));
		blockTotal = blockTaps.x * blockTaps.y * blockSamples;
		blockPicks = min(blockTotal, 16);
		uint count = uint(blockPicks);
		status = RC_ClassifyReceivers(count, params.planeTolerance, params.normalCosine, firstPosition, firstNormal);
#if RC_RECEIVER_TEXTURE_FILTER
		if (status == 2u && (params.samples & 256u) != 0u)
		{
			uint best = RC_ClassifyMajority(count, params.planeTolerance, params.normalCosine);
			if (best < count)
			{
				RCReceiverSample point = RC_ClassifyPoint(best);
				int s;
				ivec2 offset = pickPixel(best, s) - blockFirst;
				status = 1u; firstPosition = point.position; firstNormal = point.normal;
				representative = 1.0 + float(offset.x + offset.y * 16);
			}
		}
#endif
	}
	imageStore(halfStatus, block, uvec4(status));
	imageStore(halfPosition, block, vec4(firstPosition, status == 1u ? representative : 0.0));
	imageStore(halfNormal, block, vec4(firstNormal, 0.0));
}
