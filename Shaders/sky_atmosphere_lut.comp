#version 460
#extension GL_GOOGLE_include_directive : require

#include "sky_atmosphere_common.glsl"

layout (local_size_x = 8, local_size_y = 8) in;
layout (set = 0, binding = 0, rgba16f) uniform writeonly image2D atmosphere_lut;
layout (push_constant) uniform PushConsts
{
	vec4 sun_dir;
} push_constants;

void main ()
{
	ivec2 pixel = ivec2 (gl_GlobalInvocationID.xy);
	ivec2 size = imageSize (atmosphere_lut);
	if (any (greaterThanEqual (pixel, size)))
		return;
	vec2 uv = (vec2 (pixel) + 0.5) / vec2 (size);
	float azimuth = uv.x * (2.0 * 3.14159265);
	float elevation = uv.y * uv.y * (0.5 * 3.14159265);
	float horizontal = cos (elevation);
	vec3 direction = vec3 (cos (azimuth) * horizontal, sin (elevation), sin (azimuth) * horizontal);
	vec3 sun = normalize (push_constants.sun_dir.xyz);
	vec3 atmosphere_sun = vec3 (sun.x, sun.z, -sun.y);
	imageStore (atmosphere_lut, pixel, vec4 (compute_atmosphere (direction, atmosphere_sun), 1.0));
}
