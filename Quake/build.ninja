# This is the build file for project "vkquake"
# It is autogenerated by the Meson build system.
# Do not edit by hand.

ninja_required_version = 1.8.2

# Rules for module scanning.

# Rules for compiling.

rule c_COMPILER_FOR_BUILD
 command = /usr/bin/gcc $ARGS -MD -MQ $out -MF $DEPFILE -o $out -c $in
 deps = gcc
 depfile = $DEPFILE_UNQUOTED
 description = Compiling C object $out

rule cpp_COMPILER
 command = /usr/bin/g++ $ARGS -MD -MQ $out -MF $DEPFILE -o $out -c $in
 deps = gcc
 depfile = $DEPFILE_UNQUOTED
 description = Compiling C++ object $out

# Rules for linking.

rule c_LINKER_FOR_BUILD
 command = /usr/bin/gcc $ARGS -o $out $in $LINK_ARGS
 description = Linking target $out

rule cpp_LINKER
 command = /usr/bin/g++ $ARGS -o $out $in $LINK_ARGS
 description = Linking target $out

# Other rules

rule CUSTOM_COMMAND
 command = $COMMAND
 description = $DESC
 restat = 1

rule CUSTOM_COMMAND_DEP
 command = $COMMAND
 deps = gcc
 depfile = $DEPFILE_UNQUOTED
 description = $DESC
 restat = 1

rule REGENERATE_BUILD
 command = /usr/bin/meson --internal regenerate /home/tremor/Desktop/Quiver .
 description = Regenerating build files
 generator = 1

# Phony build target, always out of date

build PHONY: phony 

# Build rules for targets

build bintoc.p/Shaders_bintoc.c.o: c_COMPILER_FOR_BUILD ../Shaders/bintoc.c
 DEPFILE = bintoc.p/Shaders_bintoc.c.o.d
 DEPFILE_UNQUOTED = bintoc.p/Shaders_bintoc.c.o.d
 ARGS = -Ibintoc.p -I. -I.. -fdiagnostics-color=always -DNDEBUG -D_FILE_OFFSET_BITS=64 -Wall -Winvalid-pch -std=gnu11 -O3

build bintoc: c_LINKER_FOR_BUILD bintoc.p/Shaders_bintoc.c.o
 LINK_ARGS = -Wl,--as-needed -Wl,--no-undefined -Wl,-O1

build mkpak.p/Misc_vq_pak_mkpak.c.o: c_COMPILER_FOR_BUILD ../Misc/vq_pak/mkpak.c
 DEPFILE = mkpak.p/Misc_vq_pak_mkpak.c.o.d
 DEPFILE_UNQUOTED = mkpak.p/Misc_vq_pak_mkpak.c.o.d
 ARGS = -Imkpak.p -I. -I.. -fdiagnostics-color=always -DNDEBUG -D_FILE_OFFSET_BITS=64 -Wall -Winvalid-pch -std=gnu11 -O3

build mkpak: c_LINKER_FOR_BUILD mkpak.p/Misc_vq_pak_mkpak.c.o
 LINK_ARGS = -Wl,--as-needed -Wl,--no-undefined -Wl,-O1

build vkquake.pak: CUSTOM_COMMAND  | mkpak
 COMMAND = /home/tremor/Desktop/Quiver/Quake/mkpak /home/tremor/Desktop/Quiver/Quake/vkquake.pak /home/tremor/Desktop/Quiver/Misc/vq_pak /home/tremor/Desktop/Quiver/Misc/vq_pak/vq_pak_contents.txt
 description = Generating$ run-mkpak$ with$ a$ custom$ command

build embedded_pak.cpp: CUSTOM_COMMAND  | bintoc vkquake.pak
 COMMAND = /home/tremor/Desktop/Quiver/Quake/bintoc -c /home/tremor/Desktop/Quiver/Quake/vkquake.pak vkquake.pak /home/tremor/Desktop/Quiver/Quake/embedded_pak.cpp
